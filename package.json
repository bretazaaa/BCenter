{
  "name": "bcenter",
  "productName": "BCenter",
  "version": "0.3.0",
  "description": "Windows desktop app to monitor and maintain Proxmox VE infrastructure",
  "license": "GPL-3.0-only",
  "author": "Bretaza",
  "homepage": "https://github.com/bretazaaa/BCenter",
  "repository": {
    "type": "git",
    "url": "https://github.com/bretazaaa/BCenter.git"
  },
  "bugs": {
    "url": "https://github.com/bretazaaa/BCenter/issues"
  },
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "dist": "npm run typecheck && npm test && electron-vite build && electron-builder --win --x64"
  },
  "dependencies": {
    "electron-updater": "^6.8.9",
    "ssh2": "^1.17.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ssh2": "^1.15.6",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "lucide-react": "^1.59.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1",
    "typescript": "5.9",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "zustand": "^5.0.15"
  }
}
